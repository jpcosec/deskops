+@pytest.mark.parametrize("desk", ["bare_desk", "store_desk"])
+def test_task_atoms_field_satisfies_the_link_gate(desk: str, request: pytest.FixtureRequest) -> None:
+    """A task with `atoms` and no atom reference passes the link gate; one with neither fails."""
+    root: Path = request.getfixturevalue(desk)
+    _write(root / "desk" / "tasks" / "task-atoms-field.md", _task("task-atoms-field", [], [ATOM]))
+    _write(root / "desk" / "tasks" / "task-no-atoms.md", _task("task-no-atoms", [], []))
+    if desk == "store_desk":
+        from sldb.api import track_document_file
+
+        pythonpath = str(Path(__file__).resolve().parents[1])
+        for task_id in ("task-atoms-field", "task-no-atoms"):
+            path = root / "desk" / "tasks" / f"{task_id}.md"
+            track_document_file(root / ".sldb", "TaskDoc", path, name=task_id, pythonpath=pythonpath, force=True)
+    operations = DeskopsOperations(root)
+
+    with_atoms = operations.verify_task_closeout("task-atoms-field")["gates"]["atom_or_materialization_link"]
+    assert with_atoms["ok"] is True
+    assert with_atoms["evidence"] == [ATOM]
+
+    without = operations.verify_task_closeout("task-no-atoms")["gates"]["atom_or_materialization_link"]
+    assert without["ok"] is False
+    assert [f["code"] for f in without["findings"]] == ["missing_atom_or_materialization_link"]
+
+
